]}],"source":["# ==============================================================================\n","# SECTION 5: TRAINING-DATA PREPROCESSING AND FEATURE ENGINEERING\n","# Standardizing numeric values for optimal RBF Kernel SVM performance.\n","# Fit MUST occur ONLY on training set to prevent data leakage.\n","# ==============================================================================\n","\n","scaler = StandardScaler()\n","\n","# Fit and transform ONLY on training set\n","X_train_scaled = scaler.fit_transform(X_train)\n","\n","# Transform test set using parameters learned from training set\n","X_test_scaled = scaler.transform(X_test)\n","\n","print(\"StandardScaler fitted on Training Set and applied to Test Set.\")"]},{"cell_type":"code","execution_count":11,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":22,"status":"ok","timestamp":1794305396272,"user":{"displayName":"Alemneh Maru","userId":"12378749349376248050"},"user_tz":-180},"id":"KRK-WyJpeQP-","outputId":"5ddb2c0a-8252-49f4-f367-4d88528837ad"},"outputs":[{"output_type":"stream","name":"stdout","text":["Original Training class counts  :\n","Default\n","0    816\n","1    144\n","Name: count, dtype: int64\n","Resampled Training class counts :\n","Default\n","1    816\n","0    816\n","Name: count, dtype: int64\n"]}],"source":["# ==============================================================================\n","# SECTION 6: FEATURE SELECTION AND CLASS-IMBALANCE HANDLING\n","# Applying Synthetic Minority Over-sampling Technique (SMOTE) strictly\n","# to training data only. Test set retains natural distribution.\n","# ==============================================================================\n","\n","smote = SMOTE(random_state=SEED)\n","X_train_resampled, y_train_resampled = smote.fit_resample(X_train_scaled, y_train)\n","\n","print(f\"Original Training class counts  :\\n{y_train.value_counts()}\")\n","print(f\"Resampled Training class counts :\\n{pd.Series(y_train_resa